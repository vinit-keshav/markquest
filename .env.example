SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=vinitkeshavorg@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
OTP_EMAIL_FROM=vinitkeshavorg@gmail.com

# Shared by auth, watchlist, trading and portfolio. Generate a private random value.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
FINNHUB_TOKEN=

# Separate databases are recommended; existing local values remain in your ignored .env.
AUTH_DB_URL=jdbc:mysql://localhost:3306/marketquest_auth
AUTH_DB_USERNAME=marketquest_user
AUTH_DB_PASSWORD=replace-me
WATCHLIST_DB_URL=jdbc:mysql://localhost:3306/marketquest_watchlist
WATCHLIST_DB_USERNAME=marketquest_user
WATCHLIST_DB_PASSWORD=replace-me
PORTFOLIO_DB_URL=jdbc:mysql://localhost:3306/marketquest_portfolio
PORTFOLIO_DB_USERNAME=marketquest_user
PORTFOLIO_DB_PASSWORD=replace-me
